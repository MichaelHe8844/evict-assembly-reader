# -*- coding: utf-8 -*-
"""LoRA 冒烟：让 Qwen2.5-3B 学会「问题 + 表 -> 可执行算式」。

只做可行性验证，不追求分数：
  1) 4-bit + LoRA 在 16GB 单卡能不能跑；
  2) 损失能不能降；
  3) 生成的式子能不能被解析并执行。

用法：
  python lora_compile.py --steps 80 --eval_n 30
"""
import argparse
import json
import random
import re
import sys
import time

import torch
from torch.utils.data import DataLoader, Dataset

OPS = {
    "add": lambda *a: sum(a),
    "subtract": lambda a, b: a - b,
    "multiply": lambda *a: __import__("math").prod(a),
    "divide": lambda a, b: a / b if b else None,
    "greater": lambda a, b: 1.0 if a > b else 0.0,
    "average": lambda *a: sum(a) / len(a),
    "exp": lambda a, b: a ** b,
}
SAFE = re.compile(r"^[0-9eE\.\,\-\+\(\)\sa-z_]+$")


def linearize(x):
    tab = x.get("table") or []
    rows = []
    for r in tab[:24]:
        rows.append(" | ".join(str(c).strip() for c in r))
    pre = " ".join(x.get("pre_text") or [])
    post = " ".join(x.get("post_text") or [])
    body = (pre + " " + post).strip()
    return "表：\n" + "\n".join(rows) + "\n\n文：\n" + body[:1600]


def prompt_of(x):
    return linearize(x) + "\n\n问：" + x["qa"]["question"].strip() + "\n式："


def run_prog(prog):
    """把 subtract(a,b) 这类式子求值。"""
    p = prog.strip().split("\n")[0].strip()
    p = re.split(r"答|式|问", p)[0].strip()
    p = re.sub(r"const_(\d+)", r"\1", p)
    p = p.replace("%", "")
    if not SAFE.match(p) or "(" not in p:
        return None
    try:
        return float(eval(p, {"__builtins__": {}}, dict(OPS)))
    except Exception:
        return None


def close(a, b, tol=1e-3):
    if a is None or b is None:
        return False
    return abs(a - b) <= tol * max(1.0, abs(b))


def load_rows(path, limit=None, single=True):
    d = json.load(open(path, encoding="utf-8"))
    out = []
    for x in d:
        qa = x.get("qa") or {}
        st = qa.get("steps") or []
        prog = (qa.get("program") or "").strip()
        if not prog or not prog.endswith(")"):
            continue
        if single and len(st) != 1:
            continue
        try:
            ans = float(qa.get("exe_ans"))
        except (TypeError, ValueError):
            continue
        prog = re.sub(r"const_(\d+)", r"\1", prog)
        out.append(dict(id=x["id"], prompt=prompt_of(x), target=prog, ans=ans))
        if limit and len(out) >= limit:
            break
    return out


class DS(Dataset):
    def __init__(self, rows, tok, max_len=1152):
        self.items = []
        for r in rows:
            pi = tok(r["prompt"], add_special_tokens=False)["input_ids"]
            ti = tok(r["target"] + tok.eos_token, add_special_tokens=False)["input_ids"]
            pi = pi[-(max_len - len(ti) - 8):] if len(pi) + len(ti) > max_len else pi
            ids = pi + ti
            self.items.append((ids, [-100] * len(pi) + ti))

    def __len__(self):
        return len(self.items)

    def __getitem__(self, i):
        return self.items[i]


def coll(batch, pad):
    L = max(len(x[0]) for x in batch)
    ids = torch.full((len(batch), L), pad, dtype=torch.long)
    lab = torch.full((len(batch), L), -100, dtype=torch.long)
    am = torch.zeros((len(batch), L), dtype=torch.long)
    for i, (a, b) in enumerate(batch):
        ids[i, :len(a)] = torch.tensor(a)
        lab[i, :len(b)] = torch.tensor(b)
        am[i, :len(a)] = 1
    return ids, am, lab


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--base", default="E:/KV_models/Qwen2.5-3B-Instruct")
    ap.add_argument("--steps", type=int, default=80)
    ap.add_argument("--bs", type=int, default=1)
    ap.add_argument("--accum", type=int, default=8)
    ap.add_argument("--lr", type=float, default=2e-4)
    ap.add_argument("--max_len", type=int, default=1152)
    ap.add_argument("--limit", type=int, default=600)
    ap.add_argument("--eval_n", type=int, default=30)
    ap.add_argument("--out", default="../results/lora_compile")
    args = ap.parse_args()

    from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training
    from transformers import (AutoModelForCausalLM, AutoTokenizer,
                              BitsAndBytesConfig)

    tok = AutoTokenizer.from_pretrained(args.base)
    if tok.pad_token is None:
        tok.pad_token = tok.eos_token

    print("[1/4] 读数据", flush=True)
    tr = load_rows("../data/train.json", limit=args.limit)
    dv = load_rows("../data/dev.json", limit=2000)
    print("     训练 %d 题（单步）｜ dev 单步 %d 题" % (len(tr), len(dv)), flush=True)

    print("[2/4] 载入 4-bit 底座", flush=True)
    bnb = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type="nf4",
                             bnb_4bit_compute_dtype=torch.bfloat16,
                             bnb_4bit_use_double_quant=True)
    model = AutoModelForCausalLM.from_pretrained(
        args.base, quantization_config=bnb, device_map="cuda")
    model = prepare_model_for_kbit_training(model)
    model.gradient_checkpointing_enable()
    model = get_peft_model(model, LoraConfig(
        r=16, lora_alpha=32, lora_dropout=0.05, bias="none",
        task_type="CAUSAL_LM",
        target_modules=["q_proj", "k_proj", "v_proj", "o_proj"]))
    n_p = sum(p.numel() for p in model.parameters() if p.requires_grad)
    print("     可训练参数 %.2fM" % (n_p / 1e6), flush=True)

    ds = DS(tr, tok, args.max_len)
    dl = DataLoader(ds, batch_size=args.bs, shuffle=True,
                    collate_fn=lambda b: coll(b, tok.pad_token_id))
    opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],
                            lr=args.lr)
    total = args.steps
    model.train()
    print("[3/4] 训练 %d 步" % total, flush=True)
    it, step, t0, run = 0, 0, time.time(), 0.0
    while step < total:
        for ids, am, lab in dl:
            ids, am, lab = ids.cuda(), am.cuda(), lab.cuda()
            out = model(input_ids=ids, attention_mask=am, labels=lab)
            loss = out.loss / args.accum
            loss.backward()
            run += float(out.loss)
            if (it + 1) % args.accum == 0:
                torch.nn.utils.clip_grad_norm_(
                    [p for p in model.parameters() if p.requires_grad], 1.0)
                opt.step()
                opt.zero_grad(set_to_none=True)
                step += 1
                if step % 10 == 0:
                    print("   step %3d  loss %.4f  %.0fs"
                          % (step, run / (it + 1), time.time() - t0), flush=True)
                if step >= total:
                    break
            it += 1

    print("[4/4] dev 评测 %d 题" % args.eval_n, flush=True)
    model.eval()
    ok_p = ok_e = 0
    samples = []
    for r in dv[:args.eval_n]:
        pi = tok(r["prompt"], return_tensors="pt", add_special_tokens=False,
                 truncation=True, max_length=args.max_len - 64).to("cuda")
        with torch.no_grad():
            g = model.generate(**pi, max_new_tokens=40, do_sample=False,
                               pad_token_id=tok.pad_token_id,
                               stop_strings=["\n", "答"], tokenizer=tok)
        out = tok.decode(g[0][pi["input_ids"].shape[1]:], skip_special_tokens=True)
        val = run_prog(out)
        ok_p += val is not None
        ok_e += close(val, r["ans"])
        if len(samples) < 5:
            samples.append((out.strip()[:70], r["target"][:60], val, r["ans"]))
    n = min(args.eval_n, len(dv))
    print("   可执行率 %.3f  EM %.3f  (n=%d)" % (ok_p / n, ok_e / n, n))
    for a, b, v, y in samples:
        print("   生成 %-42s | gold %-30s | %s vs %s" % (a, b, v, y))
    model.save_pretrained(args.out)
    print("已保存到 %s" % args.out)


if __name__ == "__main__":
    main()

          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=SimSun;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;arcSize=6;"

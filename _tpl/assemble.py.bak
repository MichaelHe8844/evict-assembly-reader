# -*- coding: utf-8 -*-
"""把 body2.docx（pandoc 产物）装配成《计算机科学》模板格式的 docx。

规范（读自 计算机科学模板.doc）：
  中文题目 黑体三号16pt / 作者 宋体五号加粗 / 单位 仿宋小五9pt
  摘要 仿宋小五9pt（"摘 要"加粗）/ 关键词 宋体小五9pt
  英文题目 TNR加粗14pt / 英文作者 TNR五号10.5 / 英文单位 TNR小五9
  Abstract·Keywords 标签黑体9pt
  正文 宋体小五9pt 双栏 / 一级标题 黑体五号10.5 / 二级 黑体9 / 三级 楷体9
  表题、图题 中英双语 7.5pt
"""
import copy
import docx
from docx.enum.section import WD_SECTION
from docx.enum.table import WD_TABLE_ALIGNMENT
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml.ns import qn
from docx.shared import Pt, Cm, RGBColor

SRC = "_tpl/body2.docx"
OUT = "论文_计算机科学模板.docx"

TITLE_CN = "压缩证据下的取证装配与编译式读取"
AUTHOR_CN = "贺明涵"
AFFIL_CN = "（上海第二工业大学 计算机与信息工程学院，上海 201209）"
EMAIL_CN = "（20251513112@sspu.edu.cn）"

ABS_CN = (
    '金融数值问答需从长财报中取数并计算，而 KV 缓存压缩会把数值与其行头、列名、单位割断：数值仍在，'
    '读者却无从判断它是谁的量、以什么为单位——答得出，却无法复算。针对这一问题提出三层方法：'
    '把保留单位由 token 提升为可复算的锚点组，以闭包约束整组装入；在驱逐前用离线训练的定位器'
    '把题目所需的一对操作数钉入预算，以区分“结构完整”与“这道题要的完整”；读者只生成程序，'
    '由白名单执行器求值。在 FinQA 官方 test 筛选出的 216 道单步题、3%–20% 四档预算上评测'
    '（Qwen2.5-3B，逐题配对）。结果表明：四档平均 EM 由 0.280 升至 0.513；3% 档由 0.130 升至 0.412，'
    '20% 档固定装配换程序读者由 0.477 升至 0.634，分别高出 28.2 与 15.7 个百分点；单看保留粒度，'
    'token 级换为锚点组级提高 13.0～44.9 个百分点（平均 +31.8，p<1e-5），而组级整装固定后'
    '改进排序信号仅 +0.9～7.9。需要说明的是，绑定本身不改变 EM，其价值在可复算与可弃答，'
    '粒度增益主要来自整装。同一对照在 Llama-3.2-3B 上次序一致。三层不可互替，权重随预算由取证转向读取；'
    '钉对层无需重训即可叠加到现有注意力压缩器。结论限于 3B 级模型与英文财报单步问答。')

KW_CN = '金融数值问答；证据压缩；锚点组；任务相关选择；程序化读取'
CLC = "TP391.1"

TITLE_EN = "Evidence Assembly and Compiled Reading under Compressed Evidence"
AUTHOR_EN = "HE Minghan"
AFFIL_EN = "(School of Computer and Information Engineering, Shanghai Polytechnic University, Shanghai 201209, China)"

ABS_EN = (
    'Financial numerical question answering must extract a few values from long reports and compute with '
    'them, but KV-cache compression severs a value from its row header, column name and unit: the number '
    'survives in the text, but a reader can no longer tell whose quantity it is or in what units: the '
    'answer can be produced, yet the computation can no longer be recomputed. A three-layer method is proposed. '
    'Retention is redefined from tokens to anchor groups, a value together with its structural bindings, '
    'kept whole under a closure constraint; before eviction an offline-trained locator pins the pair of '
    'operands the question needs into the budget, separating structural completeness from task relevance; '
    'the reader then emits a program only, which a whitelisted executor evaluates. On 216 single-step '
    'questions filtered from the official FinQA test set at budgets of 3, 5, 10 and 20 percent '
    '(Qwen2.5-3B; per-question pairing, document-clustered bootstrap), mean EM rises from 0.280 to 0.513. '
    'At 3 percent it rises from 0.130 to 0.412 (+28.2 points) once the new assembly and the program reader '
    'are applied; at 20 percent, holding the assembly fixed and swapping in the program reader raises EM '
    'from 0.477 to 0.634 (+15.7). Changing only the retention unit, from token-level attention to '
    'anchor-group retention, is worth 13.0 to 44.9 points (mean +31.8, p<1e-5), whereas improving the '
    'ranking signal within a fixed group assembly is worth 0.9 to 7.9. Note that bindings alone do not '
    'change EM; their value is recomputability and abstention, while the accuracy gains above come from '
    'whole-group assembly, pinning and reading. The same ordering reproduces on '
    'Llama-3.2-3B. The three layers act on different objects and cannot substitute for one another; their '
    'relative weight shifts from evidence preservation to reading as the budget loosens. The pinning layer '
    'requires no retraining of the underlying compressor and stacks onto existing attention-based '
    'compressors. Results are limited to 3B-scale models and English single-step financial QA.')

KW_EN = ('financial numerical question answering; evidence compression; anchor group; task-relevant selection; programmatic reading')


# 表格英文题注：按出现顺序
TAB_EN = [
    ("表 1", "Table 1  Dose-response of assembly order"),
    ("表 2", "Table 2  End-to-end results under strictly matched budgets"),
    ("表 3", "Table 3  Two readers by two assemblies on 216 test questions"),
    ("表 4", "Table 4  Matched-budget comparison of granularity and ranking signal"),
    ("表 5", "Table 5  The same contrasts on two backbones"),
]
FIG_EN = ("Fig.1  Values are kept whole with their bindings, the operand pair the question needs is pinned "
          "before eviction, and arithmetic is delegated to an executor")


def set_font(run, ascii_font, ea_font, size, bold=None, italic=None):
    run.font.name = ascii_font
    run.font.size = Pt(size)
    if bold is not None:
        run.font.bold = bold
    if italic is not None:
        run.font.italic = italic
    rpr = run._element.get_or_add_rPr()
    rf = rpr.find(qn("w:rFonts"))
    if rf is None:
        rf = rpr.makeelement(qn("w:rFonts"), {})
        rpr.append(rf)
    rf.set(qn("w:ascii"), ascii_font)
    rf.set(qn("w:hAnsi"), ascii_font)
    rf.set(qn("w:eastAsia"), ea_font)


def para(doc_or_cell, text="", align=None, size=9, ascii_font="Times New Roman",
         ea_font="宋体", bold=False, space_before=0, space_after=0, first_indent=None,
         line=None):
    p = doc_or_cell.add_paragraph()
    if align is not None:
        p.alignment = align
    pf = p.paragraph_format
    pf.space_before = Pt(space_before)
    pf.space_after = Pt(space_after)
    if first_indent is not None:
        pf.first_line_indent = Pt(first_indent)
    if line is not None:
        pf.line_spacing = line
    if text:
        r = p.add_run(text)
        set_font(r, ascii_font, ea_font, size, bold=bold)
    return p


def rich_para(p, chunks, size=9, ascii_font="Times New Roman", ea_font="宋体"):
    """chunks: [(text, bold)]"""
    for text, bold in chunks:
        r = p.add_run(text)
        set_font(r, ascii_font, ea_font, size, bold=bold)
    return p


def build():
    doc = docx.Document(SRC)
    body = doc.element.body

    # ---------- 前置内容（逐段插到最前） ----------
    anchor = doc.paragraphs[0]
    front = []

    front.append(para(doc, TITLE_CN, WD_ALIGN_PARAGRAPH.CENTER, 16, "Times New Roman", "黑体",
                      bold=False, space_before=0, space_after=6))
    front.append(para(doc, AUTHOR_CN, WD_ALIGN_PARAGRAPH.CENTER, 10.5, "Times New Roman", "宋体",
                      bold=True, space_after=3))
    front.append(para(doc, AFFIL_CN, WD_ALIGN_PARAGRAPH.CENTER, 9, "Times New Roman", "仿宋", space_after=0))
    front.append(para(doc, EMAIL_CN, WD_ALIGN_PARAGRAPH.CENTER, 9, "Times New Roman", "仿宋", space_after=6))

    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    p.paragraph_format.space_after = Pt(3)
    rich_para(p, [("摘  要  ", True), (ABS_CN.replace("**", ""), False)], 9, "Times New Roman", "仿宋")
    front.append(p)

    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    p.paragraph_format.space_after = Pt(3)
    rich_para(p, [("关键词：  ", True), (KW_CN, False)], 9, "Times New Roman", "宋体")
    front.append(p)

    p = doc.add_paragraph()
    p.paragraph_format.space_after = Pt(8)
    rich_para(p, [("中图分类号  ", True), (CLC, False)], 9, "Times New Roman", "宋体")
    front.append(p)

    p_te = doc.add_paragraph()
    p_te.alignment = WD_ALIGN_PARAGRAPH.CENTER
    p_te.paragraph_format.space_before = Pt(6)
    p_te.paragraph_format.space_after = Pt(6)
    _half = TITLE_EN.find("under Compressed")
    r1 = p_te.add_run(TITLE_EN[:_half])   # 保留词间空格，勿 rstrip
    set_font(r1, "Times New Roman", "黑体", 14, bold=True)
    r1.add_break()
    r2 = p_te.add_run(TITLE_EN[_half:])
    set_font(r2, "Times New Roman", "黑体", 14, bold=True)
    front.append(p_te)
    front.append(para(doc, AUTHOR_EN, WD_ALIGN_PARAGRAPH.CENTER, 10.5, "Times New Roman", "宋体", space_after=3))
    front.append(para(doc, AFFIL_EN, WD_ALIGN_PARAGRAPH.CENTER, 9, "Times New Roman", "宋体", space_after=6))

    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    p.paragraph_format.space_after = Pt(3)
    rich_para(p, [("Abstract  ", True), (ABS_EN, False)], 9, "Times New Roman", "宋体")
    front.append(p)

    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
    p.paragraph_format.space_after = Pt(6)
    rich_para(p, [("Keywords  ", True), (KW_EN, False)], 9, "Times New Roman", "宋体")
    front.append(p)

    from docx.oxml import OxmlElement as _OE3
    for fp in front:
        fp.paragraph_format.first_line_indent = Pt(0)
        _pPr = fp._element.get_or_add_pPr()
        for _old in _pPr.findall(qn("w:spacing")):
            _pPr.remove(_old)
        _sp = _OE3("w:spacing")
        _sp.set(qn("w:line"), "240")
        _sp.set(qn("w:lineRule"), "atLeast")   # 最小值：大字号标题不会被裁
        _pPr.append(_sp)
    # 把 front 段落移到最前（保持顺序）
    for p in front:
        body.remove(p._element)
        anchor._element.addprevious(p._element)

    # ---------- 分节：前置单栏，正文双栏（显式设置 A4 与边距） ----------
    from docx.oxml import OxmlElement

    def make_sect(cols_num, continuous):
        sp = OxmlElement("w:sectPr")
        if continuous:
            t = OxmlElement("w:type")
            t.set(qn("w:val"), "continuous")
            sp.append(t)
        pgsz = OxmlElement("w:pgSz")
        pgsz.set(qn("w:w"), "11906")
        pgsz.set(qn("w:h"), "16838")
        sp.append(pgsz)
        pgmar = OxmlElement("w:pgMar")
        for k, v in (("top", "1440"), ("right", "1800"), ("bottom", "1440"),
                     ("left", "1800"), ("header", "851"), ("footer", "992"), ("gutter", "0")):
            pgmar.set(qn("w:" + k), v)
        sp.append(pgmar)
        cols = OxmlElement("w:cols")
        cols.set(qn("w:num"), str(cols_num))
        cols.set(qn("w:space"), "425" if cols_num == 2 else "0")
        if cols_num == 2:
            cols.set(qn("w:equalWidth"), "1")
        sp.append(cols)
        grid = OxmlElement("w:docGrid")
        grid.set(qn("w:linePitch"), "312")
        sp.append(grid)
        return sp

    last_front = front[-1]._element
    pPr = last_front.get_or_add_pPr()
    for old in pPr.findall(qn("w:sectPr")):
        pPr.remove(old)
    pPr.append(make_sect(1, False))

    body_elm = doc.element.body
    for old in body_elm.findall(qn("w:sectPr")):
        body_elm.remove(old)
    body_elm.append(make_sect(2, True))

    # ---------- 正文段落格式 ----------
    front_ids = {id(x._element) for x in front}
    for p in doc.paragraphs:
        if id(p._element) in front_ids:
            continue
        st = p.style.name
        if st == "Heading 1":
            p.paragraph_format.space_before = Pt(8)
            p.paragraph_format.space_after = Pt(4)
            p.paragraph_format.keep_with_next = True
            for r in p.runs:
                set_font(r, "Times New Roman", "黑体", 10.5, bold=False)
                r.font.color.rgb = RGBColor(0, 0, 0)
        elif st == "Heading 2":
            p.paragraph_format.space_before = Pt(5)
            p.paragraph_format.space_after = Pt(2)
            p.paragraph_format.keep_with_next = True
            for r in p.runs:
                set_font(r, "Times New Roman", "黑体", 9, bold=False)
                r.font.color.rgb = RGBColor(0, 0, 0)
        elif st in ("Body Text", "First Paragraph", "Normal"):
            txt = p.text.strip()
            if not txt:
                continue
            # 表格题注（加粗、居中、7.5pt）
            if txt.startswith("表 ") or txt.startswith("表"):
                if len(txt) > 1 and txt[1].isdigit() or txt.startswith("表 "):
                    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
                    p.paragraph_format.left_indent = Pt(0)
                    p.paragraph_format.right_indent = Pt(0)
                    p.paragraph_format.first_line_indent = Pt(0)
                    p.paragraph_format.space_before = Pt(4)
                    p.paragraph_format.space_after = Pt(1)
                    for r in p.runs:
                        set_font(r, "Times New Roman", "宋体", 7.5, bold=False)
                    continue
            if txt.startswith("参考文献"):
                continue
            p.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
            p.paragraph_format.first_line_indent = Pt(18)
            p.paragraph_format.space_after = Pt(0)
            p.paragraph_format.line_spacing = 1.0
            if txt.startswith("company | payments volume"):
                p.paragraph_format.first_line_indent = Pt(0)
                p.alignment = WD_ALIGN_PARAGRAPH.LEFT
                for r_ in p.runs:
                    set_font(r_, "Times New Roman", "宋体", 8.5)
            if p.style.name == "Compact" or txt[:2] in ("1.", "2.", "3.", "4."):
                p.paragraph_format.keep_together = True
            for r in p.runs:
                if r.font.size is None or r.font.name in (None, "Calibri", "宋体"):
                    set_font(r, "Times New Roman", "宋体", 9)

    # ---------- 兜底：非标题段落一律 9pt（含 Compact 列表项） ----------
    for p_ in doc.paragraphs:
        if id(p_._element) in front_ids:
            continue
        st_ = p_.style.name
        if st_.startswith("Heading") or "参考文献" in p_.text:
            continue
        if not p_.text.strip() and not p_._element.xpath(".//m:oMath"):
            continue
        is_alg = p_.text.strip().startswith("算法")
        runs_ = p_.runs
        for idx_, r_ in enumerate(runs_):
            sz = r_.font.size.pt if r_.font.size else None
            was_bold = bool(r_.font.bold)
            if sz is None or sz > 9.5:
                set_font(r_, "Times New Roman", "宋体", 9)
            if is_alg:
                continue
            r_.font.bold = False
            # 段首短引导词（原为粗体、以句号结尾）改用黑体，符合中文期刊惯例
            t_ = (r_.text or "").strip()
            if (was_bold and idx_ == 0 and len(t_) <= 16 and t_.endswith("。")
                    and len(p_.text.strip()) > len(t_) + 6):
                set_font(r_, "Times New Roman", "黑体", 9, bold=False)
                # 中文标点后不留空格
                if idx_ + 1 < len(runs_):
                    nx = runs_[idx_ + 1]
                    if (nx.text or "").startswith(" "):
                        nx.text = nx.text.lstrip()
        p_.paragraph_format.line_spacing = 1.0
        if st_ in ("Compact", "List Paragraph"):
            p_.paragraph_format.space_before = Pt(0)
            p_.paragraph_format.space_after = Pt(0)
            p_.paragraph_format.left_indent = Pt(14)
            p_.paragraph_format.first_line_indent = Pt(-14)

    # ---------- 参考文献段落 ----------
    ref_started = False
    for p in doc.paragraphs:
        if p.style.name == "Heading 1" and "参考文献" in p.text:
            ref_started = True
            continue
        if ref_started and p.text.strip():
            p.alignment = WD_ALIGN_PARAGRAPH.LEFT
            p.paragraph_format.first_line_indent = Pt(-18)
            p.paragraph_format.left_indent = Pt(18)
            p.paragraph_format.space_after = Pt(0)
            for r in p.runs:
                set_font(r, "Times New Roman", "宋体", 9)

    # ---------- 表格 ----------
    from docx.shared import Cm as _Cm
    for t in doc.tables:
        t.alignment = WD_TABLE_ALIGNMENT.CENTER
        t.autofit = False
        try:
            ncol_ = len(t.rows[0].cells)
        except Exception:
            ncol_ = 0
        # 按各列最大内容长度分配宽度（中文按 2 计）
        def _w(txt):
            return sum(2 if ord(ch) > 127 else 1 for ch in txt)

        maxlen = [1] * ncol_
        for row in t.rows:
            for i_, cell in enumerate(row.cells):
                if i_ < ncol_:
                    v = _w(cell.text.strip())
                    # 单元格内含公式（OMML）时取不到文本，给一个下限
                    if cell._tc.xpath(".//m:oMath"):
                        v = max(v, 22)
                    maxlen[i_] = max(maxlen[i_], v)
        weights = [max(4, m + 2) for m in maxlen]
        # 判断该表所在节是否单栏（跨栏区）：看其后最近的 sectPr
        cols_in_sect = 2
        el_ = t._tbl
        while el_ is not None:
            nxt_ = el_.getnext()
            if nxt_ is None:
                break
            if nxt_.tag == qn("w:p"):
                pPr_ = nxt_.find(qn("w:pPr"))
                if pPr_ is not None and pPr_.find(qn("w:sectPr")) is not None:
                    c_ = pPr_.find(qn("w:sectPr")).find(qn("w:cols"))
                    if c_ is not None and c_.get(qn("w:num")) == "1":
                        cols_in_sect = 1
                    break
            el_ = nxt_
        total = 14.0 if cols_in_sect == 1 else 6.9
        ssum = sum(weights) or 1
        widths = [total * wgt / ssum for wgt in weights]
        tblPr_ = t._tbl.tblPr
        lay = tblPr_.find(qn("w:tblLayout"))
        if lay is None:
            from docx.oxml import OxmlElement as _OE
            lay = _OE("w:tblLayout")
            tblPr_.append(lay)
        lay.set(qn("w:type"), "fixed")
        for i_, col in enumerate(t.columns):
            col.width = _Cm(widths[i_])
        for row in t.rows:
            for i_, cell in enumerate(row.cells):
                if i_ < len(widths):
                    cell.width = _Cm(widths[i_])
        try:
            ncol = len(t.rows[0].cells)
        except Exception:
            ncol = 0
        cell_sz = 7.0 if ncol >= 5 else 7.5
        tblPr = t._tbl.tblPr
        mar = tblPr.find(qn("w:tblCellMar"))
        if mar is None:
            from docx.oxml import OxmlElement as _OE
            mar = _OE("w:tblCellMar")
            tblPr.append(mar)
        for side in ("left", "right"):
            el_ = mar.find(qn("w:" + side))
            if el_ is None:
                from docx.oxml import OxmlElement as _OE
                el_ = _OE("w:" + side)
                mar.append(el_)
            el_.set(qn("w:w"), "28")
            el_.set(qn("w:type"), "dxa")
        for row in t.rows:
            for cell in row.cells:
                for p in cell.paragraphs:
                    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
                    p.paragraph_format.space_before = Pt(0)
                    p.paragraph_format.space_after = Pt(0)
                    p.paragraph_format.first_line_indent = Pt(0)
                    for r in p.runs:
                        set_font(r, "Times New Roman", "宋体", cell_sz)

    # ---------- 英文表题 + 英文图题 ----------
    for p in list(doc.paragraphs):
        txt = p.text.strip()
        for cn, en in TAB_EN:
            if txt.startswith(cn) and len(txt) > len(cn):
                newp = copy.deepcopy(p._element)
                p._element.addnext(newp)
                from docx.text.paragraph import Paragraph
                np = Paragraph(newp, p._parent)
                for r in list(np.runs):
                    r._element.getparent().remove(r._element)
                r = np.add_run(en)
                set_font(r, "Times New Roman", "宋体", 7.5, bold=False)
                np.alignment = WD_ALIGN_PARAGRAPH.CENTER
                np.paragraph_format.first_line_indent = Pt(0)
                np.paragraph_format.space_before = Pt(0)
                np.paragraph_format.space_after = Pt(4)
                # 中英题注都要与表格同页
                p.paragraph_format.keep_with_next = True
                np.paragraph_format.keep_with_next = True
                break

    # ---------- 宽表与大图跨栏（1 栏 continuous 区段） ----------
    from docx.oxml import OxmlElement as OE

    def sect_after(elm, cols):
        """在 elm 之后插入一个携带 sectPr 的空段落，用于切换分栏。"""
        para_elm = OE("w:p")
        pPr = OE("w:pPr")
        sp = make_sect(cols, True)
        pPr.append(sp)
        para_elm.append(pPr)
        elm.addnext(para_elm)
        return para_elm

    def rpr_min(elm):
        """把空段落压到 1pt 高，减少空白。"""
        rPr = OE("w:rPr")
        sz = OE("w:sz"); sz.set(qn("w:val"), "2"); rPr.append(sz)
        pPr = elm.find(qn("w:pPr"))
        if pPr is not None:
            pPr.append(rPr)

    body_elm = doc.element.body

    # ---------- 占位段 → 插图 + 中文题注（英文题注由下面的图题处理补） ----------
    from docx.shared import Cm as _Cm
    from docx.text.paragraph import Paragraph as _PImg
    for el in list(body_elm):
        if el.tag != qn("w:p"):
            continue
        _txt = "".join(x.text or "" for x in el.iter(qn("w:t"))).strip()
        if _txt != "[[FIG_METHOD]]":
            continue
        _p = _PImg(el, doc._body)
        for _r in list(_p.runs):
            _r._element.getparent().remove(_r._element)
        _p.alignment = WD_ALIGN_PARAGRAPH.CENTER
        _p.paragraph_format.first_line_indent = Pt(0)
        _p.paragraph_format.space_before = Pt(3)
        _p.paragraph_format.space_after = Pt(0)
        _p.add_run().add_picture("results/fig_method.png", width=_Cm(6.6))
        _cap = copy.deepcopy(el)
        el.addnext(_cap)
        _pc = _PImg(_cap, doc._body)
        for _r in list(_pc.runs):
            _r._element.getparent().remove(_r._element)
        _rr = _pc.add_run("三层方法：数值与其绑定作为不可分单元装入预算，驱逐前钉住问题所需的一对操作数，算术交给执行器")
        set_font(_rr, "Times New Roman", "宋体", 7.5)
        _pc.alignment = WD_ALIGN_PARAGRAPH.CENTER
        _pc.paragraph_format.first_line_indent = Pt(0)
        _pc.paragraph_format.space_before = Pt(2)
        _pc.paragraph_format.space_after = Pt(1)
        break

    # 图题：图片后的说明段 → 「图1 …」7.5pt 居中 + 「Fig.1 …」英文行
    for el in list(body_elm):
        if el.tag != qn("w:p"):
            continue
        if not (el.xpath(".//w:drawing") or el.xpath(".//w:pict")):
            continue
        nxt = el.getnext()
        if nxt is None or nxt.tag != qn("w:p"):
            continue
        txt = "".join(t.text or "" for t in nxt.xpath(".//w:t")).strip()
        if not txt:
            continue
        for r in nxt.xpath(".//w:r"):
            for t in r.xpath(".//w:t"):
                if t.text:
                    t.text = t.text
        # 重写为图题
        para_obj = [pp for pp in doc.paragraphs if pp._element is nxt]
        if not para_obj:
            continue
        pp = para_obj[0]
        for r in list(pp.runs):
            r._element.getparent().remove(r._element)
        pp.alignment = WD_ALIGN_PARAGRAPH.CENTER
        pp.paragraph_format.first_line_indent = Pt(0)
        pp.paragraph_format.space_before = Pt(2)
        pp.paragraph_format.space_after = Pt(1)
        r = pp.add_run("图1  " + txt.replace("图 1", "").strip())
        set_font(r, "Times New Roman", "宋体", 7.5, bold=False)
        # 英文行
        newp = copy.deepcopy(nxt)
        nxt.addnext(newp)
        from docx.text.paragraph import Paragraph
        np = Paragraph(newp, pp._parent)
        for rr in list(np.runs):
            rr._element.getparent().remove(rr._element)
        r2 = np.add_run(FIG_EN)
        set_font(r2, "Times New Roman", "宋体", 7.5, bold=False)
        np.alignment = WD_ALIGN_PARAGRAPH.CENTER
        np.paragraph_format.first_line_indent = Pt(0)
        np.paragraph_format.space_before = Pt(0)
        np.paragraph_format.space_after = Pt(6)

    kids = list(body_elm)

    def is_tbl(el):
        return el.tag == qn("w:tbl")

    # 1) 宽表（>=5 列）：把「表题中文 + 英文 + 表格」包进单栏
    for el in kids:
        if not is_tbl(el):
            continue
        ncol = len(el.findall(qn("w:tr"))[0].findall(qn("w:tc"))) if el.findall(qn("w:tr")) else 0
        if ncol < 3:
            continue
        # 向上找两条题注段落（英文在前、中文在其上）
        prev = el.getprevious()
        caps = []
        empties = []
        steps = 0
        while prev is not None and len(caps) < 2 and steps < 8 and prev.tag == qn("w:p"):
            steps += 1
            txt = "".join(t.text or "" for t in prev.xpath(".//w:t")).strip()
            if txt.startswith(("表", "Table")):
                caps.insert(0, prev)
                prev = prev.getprevious()
            elif txt == "":
                empties.append(prev)
                prev = prev.getprevious()
            else:
                break
        for e_ in empties:
            e_.getparent().remove(e_)
        start = caps[0] if caps else el
        sect_after(el, 1)          # 表格之后 → 本区段单栏
        prev_el = start.getprevious()
        s2 = sect_after(prev_el if prev_el is not None else el, 2)  # 之前 → 恢复双栏
        rpr_min(s2)

    # 2) 图片 + 图题：仅通栏图（宽 > 8cm）包单栏区；窄图随栏内文本走
    for el in kids:
        if el.tag != qn("w:p"):
            continue
        has_img = el.xpath(".//w:drawing") or el.xpath(".//w:pict")
        if not has_img:
            continue
        _ext = el.xpath(".//wp:extent")
        if _ext:
            _w_cm = int(_ext[0].get("cx")) / 360000.0
            if _w_cm < 8:
                continue
        nxt = el.getnext()
        cap = []
        while nxt is not None and nxt.tag == qn("w:p") and len(cap) < 2:
            t_ = "".join(x.text or "" for x in nxt.xpath(".//w:t")).strip()
            if t_.startswith(("图1", "Fig.1")):
                cap.append(nxt)
                nxt = nxt.getnext()
            else:
                break
        try:
            from docx.text.paragraph import Paragraph as _PF
            _pf = _PF(el, doc._body)
            _pf.alignment = WD_ALIGN_PARAGRAPH.CENTER
            _pf.paragraph_format.first_line_indent = Pt(0)
            _pf.paragraph_format.space_before = Pt(2)
            _pf.paragraph_format.space_after = Pt(0)
        except Exception:
            pass
        last = cap[-1] if cap else el
        sect_after(last, 1)
        prev_el = el.getprevious()
        s2 = sect_after(prev_el if prev_el is not None else el, 2)
        rpr_min(s2)

    # ---------- 参考文献转 GB/T 7714，中文条目补英译 ----------
    import sys as _sys
    _sys.path.insert(0, "_tpl")
    from gbt import convert as _gbt

    CN_EN = {
        "6": "HU S P,ZHANG G Y,ZHENG W M.A survey of key-value cache compression methods for large "
             "language model inference[J].Journal of Computer Research and Development,2026,63(4):1021-1038.",
        "16": "LI X,LIU X P,SHU Q,et al.Automatic question answering over hybrid financial tabular-text "
              "data based on positive-negative example chains[J].Journal of Chinese Information "
              "Processing,2025,39(7):102-113.",
        "24": "SUN T Z,ZHANG S,LI T L,et al.SRG-RAG:Integrating graph re-ranking and self-reflection "
              "into retrieval-augmented generation[J].Computer Science,2026,53(10):41-50.",
        "25": "WANG Y X,XU X,ZHU H B.Survey of tabular data generation techniques[J]."
              "Computer Science,2025,52(10):3-12.",
    }

    ref_on = False
    for p_ in list(doc.paragraphs):
        t_ = p_.text.strip()
        if p_.style.name == "Heading 1" and "参考文献" in t_:
            ref_on = True
            continue
        if not ref_on or not t_.startswith("["):
            continue
        try:
            from refs_fixed import REFS as _FIXED
        except Exception:
            _FIXED = {}
        _num = t_[1:t_.index("]")]
        new_txt = ("[%s] " % _num + _FIXED[int(_num)]) if _num.isdigit() and int(_num) in _FIXED else _gbt(t_)
        for r_ in list(p_.runs):
            r_._element.getparent().remove(r_._element)
        r_ = p_.add_run(new_txt)
        set_font(r_, "Times New Roman", "宋体", 9)
        num = t_[1:t_.index("]")]
        if num in CN_EN:
            newp = copy.deepcopy(p_._element)
            p_._element.addprevious(newp)
            from docx.text.paragraph import Paragraph as _P
            np_ = _P(newp, p_._parent)
            for rr in list(np_.runs):
                rr._element.getparent().remove(rr._element)
            rr = np_.add_run(CN_EN[num])
            set_font(rr, "Times New Roman", "宋体", 9)
            np_.paragraph_format.first_line_indent = Pt(-18)
            np_.paragraph_format.left_indent = Pt(18)
            np_.paragraph_format.space_after = Pt(0)

    # ---------- 最后一趟：跨栏区建好后再定列宽 ----------
    for t in doc.tables:
        try:
            ncol2 = len(t.rows[0].cells)
        except Exception:
            continue
        def _w2(txt):
            return sum(2 if ord(ch) > 127 else 1 for ch in txt)
        maxlen2 = [1] * ncol2
        for row in t.rows:
            for i2, cell in enumerate(row.cells):
                if i2 < ncol2:
                    v = _w2(cell.text.strip())
                    if cell._tc.xpath(".//m:oMath"):
                        v = max(v, 22)
                    maxlen2[i2] = max(maxlen2[i2], v)
        wts = [max(4, m + 2) for m in maxlen2]
        tot = 14.0 if ncol2 >= 3 else 6.9
        ssum2 = sum(wts) or 1
        wds = [tot * x / ssum2 for x in wts]
        # 重建 tblGrid 与 tblW（pandoc 产出的是 tblW=0% + 空 tblGrid，Word 会忽略列宽）
        from docx.oxml import OxmlElement as _OE2
        tbl_ = t._tbl
        tblPr_ = tbl_.tblPr
        for old_w in tblPr_.findall(qn("w:tblW")):
            tblPr_.remove(old_w)
        tw = sum(int(round(w * 567)) for w in wds)
        tblW = _OE2("w:tblW")
        tblW.set(qn("w:type"), "dxa")
        tblW.set(qn("w:w"), str(tw))
        tblPr_.append(tblW)
        for old_g in tbl_.findall(qn("w:tblGrid")):
            tbl_.remove(old_g)
        grid = _OE2("w:tblGrid")
        for w in wds:
            gc = _OE2("w:gridCol")
            gc.set(qn("w:w"), str(int(round(w * 567))))
            grid.append(gc)
        tbl_.insert(list(tbl_).index(tblPr_) + 1, grid)
        for row in t.rows:
            for i2, cell in enumerate(row.cells):
                if i2 < len(wds):
                    cell.width = Cm(wds[i2])

    # ---------- 表格不跨页：表前段落与表同页 + 行内不断页 ----------
    from docx.oxml import OxmlElement as _OE4
    for t_ in doc.tables:
        el_ = t_._tbl
        prev = el_.getprevious()
        while prev is not None:
            if prev.tag == qn("w:p"):
                pPr_ = prev.find(qn("w:pPr"))
                if pPr_ is not None and pPr_.find(qn("w:sectPr")) is not None:
                    prev = prev.getprevious()
                    continue
                txt = "".join(x.text or "" for x in prev.iter(qn("w:t"))).strip()
                if txt:
                    pp = [q for q in doc.paragraphs if q._element is prev]
                    if pp:
                        pp[0].paragraph_format.keep_with_next = True
                    break
            prev = prev.getprevious()
        rows_ = t_.rows
        for ri, row in enumerate(rows_):
            trPr = row._tr.get_or_add_trPr()
            if trPr.find(qn("w:cantSplit")) is None:
                trPr.append(_OE4("w:cantSplit"))
            # 除末行外，行内段落与下段同页 → 整表不被拆开
            if ri < len(rows_) - 1:
                for cell in row.cells:
                    for cp in cell.paragraphs:
                        cp.paragraph_format.keep_with_next = True

    # ---------- 公式统一为 9pt（与正文一致） ----------
    NS_M = "http://schemas.openxmlformats.org/officeDocument/2006/math"
    fixed = 0
    for mr in doc.element.body.iter("{%s}r" % NS_M):
        rPr = mr.find(qn("w:rPr"))
        if rPr is None:
            rPr = _OE3("w:rPr")
            mrpr = mr.find("{%s}rPr" % NS_M)
            if mrpr is not None:
                mrpr.addnext(rPr)
            else:
                mr.insert(0, rPr)
        for tag in ("w:rFonts", "w:sz", "w:szCs"):
            for old in rPr.findall(qn(tag)):
                rPr.remove(old)
        f = _OE3("w:rFonts")
        f.set(qn("w:ascii"), "Cambria Math")
        f.set(qn("w:hAnsi"), "Cambria Math")
        f.set(qn("w:eastAsia"), "宋体")
        sz = _OE3("w:sz"); sz.set(qn("w:val"), "18")
        szc = _OE3("w:szCs"); szc.set(qn("w:val"), "18")
        rPr.append(f); rPr.append(sz); rPr.append(szc)
        fixed += 1
    print("公式 run 定为 9pt:", fixed)

    # ---------- 表 4 题注段前分页（该表跨栏时会被分节强制分页） ----------
    _need_break = ("表 4 保留粒度", "表 5 两个底座")
    for p_ in doc.paragraphs:
        if p_.text.strip().startswith(_need_break):
            p_.paragraph_format.page_break_before = True
            print("跨栏表题注已设为段前分页：", p_.text.strip()[:12])

    # ---------- 参考文献压缩行距（争取页数） ----------
    _in_refs = False
    for p_ in doc.paragraphs:
        t_ = p_.text.strip()
        if t_.startswith("参考文献"):
            _in_refs = True
        if _in_refs and (t_.startswith("[") or (t_ and t_[0].isascii() and t_[0].isupper() and "[" not in t_[:3])):
            pf = p_.paragraph_format
            pf.space_before = Pt(0)
            pf.space_after = Pt(0)
            pf.line_spacing = 1.0

    # ---------- 页眉与页码 ----------
    # 首页（前置节）不显示页眉；正文节显示
    sec_front = doc.sections[0]
    sec_front.different_first_page_header_footer = True
    sec = doc.sections[-1]
    hdr = sec.header
    hp = hdr.paragraphs[0] if hdr.paragraphs else hdr.add_paragraph()
    for r_ in list(hp.runs):
        r_._element.getparent().remove(r_._element)
    hp.text = ""
    run = hp.add_run("贺明涵：压缩证据下的取证装配与编译式读取")
    set_font(run, "Times New Roman", "宋体", 7.5)
    hp.add_run("\t")
    fld = OxmlElement("w:fldSimple")
    fld.set(qn("w:instr"), " PAGE ")
    inner = OxmlElement("w:r")
    t_el = OxmlElement("w:t")
    t_el.text = "1"
    inner.append(t_el)
    fld.append(inner)
    hp._p.append(fld)
    hp.alignment = WD_ALIGN_PARAGRAPH.LEFT
    from docx.enum.text import WD_TAB_ALIGNMENT
    hp.paragraph_format.tab_stops.add_tab_stop(Cm(14.6), WD_TAB_ALIGNMENT.RIGHT)

    # ---------- 清理无用的空段落（保留携带 sectPr 的） ----------
    removed = 0
    for p_ in list(doc.paragraphs):
        if p_.text.strip():
            continue
        if p_._element.xpath(".//w:drawing"):
            continue
        # 行间公式段落 text 为空，但其内容在 OMML 里，不能当空行删掉
        if p_._element.xpath(".//m:oMath"):
            continue
        pPr = p_._element.find(qn("w:pPr"))
        if pPr is not None and pPr.find(qn("w:sectPr")) is not None:
            continue
        p_._element.getparent().remove(p_._element)
        removed += 1
    print("清理空段落:", removed)

    doc.save(OUT)
    print("已生成", OUT)


if __name__ == "__main__":
    build()
